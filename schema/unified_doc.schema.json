{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/unified_doc.schema.json",
  "type": "object",
  "required": [
    "meta",
    "intro",
    "api_overview",
    "resources",
    "components",
    "compliance",
    "change_log"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "title",
        "version"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "date": {
          "type": [
            "string",
            "null"
          ]
        },
        "organization": {
          "type": [
            "string",
            "null"
          ]
        },
        "docsCode": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}