    {
      "tag": "Statements Async",
      "summary": "Асинхронная выписка",
      "endpoints": [
        {
          "operationId": "createStatementsAccountId",
          "method": "POST",
          "path": "/statements",
          "summary": "Создание ресурса выписки",
          "description": "Создаёт ресурс выписки по accountId.",
          "parameters": [
            {
              "name": "x-fapi-interaction-id",
              "in": "header",
              "required": true,
              "schema": {
                "type": "string"
              },
              "description": "RFC4122 UUID идентификатор корреляции"
            },
            {
              "name": "x-idempotency-key",
              "in": "header",
              "required": false,
              "schema": {
                "type": "string"
              },
              "description": "Идемпотентность запроса"
            },
            {
              "name": "x-jws-signature",
              "in": "header",
              "required": true,
              "schema": {
                "type": "string"
              },
              "description": "Отделяемая подпись JWS"
            }
          ],
          "requestBody": {
            "required": true,
            "content": [
              {
                "mediaType": "application/json",
                "schemaRef": "#/components/schemas/StatementInitRequest"
              }
            ]
          },
          "responses": [
            {
              "status": "201",
              "description": "Created",
              "content": [
                {
                  "mediaType": "application/json",
                  "schemaRef": "#/components/schemas/StatementInitResponse"
                }
              ]
            }
          ],
          "security": [
            "oauth2"
          ],
          "examples": null
        },
        {
          "operationId": "getStatementsStatementId",
          "method": "GET",
          "path": "/statements/{statementId}",
          "summary": "Получение выписки по идентификатору",
          "description": "Возвращает выписку по statementId; поддерживает фильтрацию по датам.",
          "parameters": [
            {
              "name": "statementId",
              "in": "path",
              "required": true,
              "schema": {
                "type": "string"
              },
              "description": "Идентификатор выписки"
            },
            {
              "name": "fromBookingDateTime",
