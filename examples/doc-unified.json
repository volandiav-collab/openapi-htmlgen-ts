              "required": false,
              "schema": {
                "type": "string"
              },
              "description": "Начало периода (date-time)"
            },
            {
              "name": "toBookingDateTime",
              "in": "query",
              "required": false,
              "schema": {
                "type": "string"
              },
              "description": "Окончание периода (date-time)"
            },
            {
              "name": "x-fapi-interaction-id",
              "in": "header",
              "required": true,
              "schema": {
                "type": "string"
              },
              "description": "RFC4122 UUID идентификатор корреляции"
            }
          ],
          "requestBody": null,
          "responses": [
            {
              "status": "200",
              "description": "OK",
              "content": [
                {
                  "mediaType": "application/json",
                  "schemaRef": "#/components/schemas/StatementStatementIdResponse"
                }
              ]
            }
          ],
          "security": [
            "oauth2"
          ],
          "examples": null
        }
      ]
    },
