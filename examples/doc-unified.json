{
  "meta": {
    "title": "Открытые программные интерфейсы. Получение информации о банковских счетах клиента. Методы для Юридических Лиц.",
    "version": "2.0.0",
    "date": "2025-10-07",
    "organization": "Банк России",
    "docs_code": "СТО БР — AISP-LE"
  },
  "intro": {
    "summary": "Спецификация API описывает конечные точки, модели данных и контроль доступа для получения информации по банковским счетам, включая счета ЮЛ.",
    "purpose": "Унифицированная публикация спецификации API в HTML-формате.",
    "audience": [
      "Архитекторы",
      "Разработчики",
      "Тестировщики"
    ],
    "terms": [
      {
        "term": "ППИУ",
        "definition": "Поставщик платежных и информационных услуг."
      },
      {
        "term": "СПИУ",
        "definition": "Сторонний поставщик информационных услуг."
      }
    ]
  },
  "api_overview": {
    "servers": [
      {
        "url": "https://api.bank.example/open-banking/v1/aisp-le",
        "description": "Прод",
        "env": "prod"
      }
    ],
    "security": [
      {
        "scheme": "oauth2",
        "description": "Client Authorization Code Flow",
        "flows": [
          "authorization_code"
        ]
      }
    ],
    "tags": [
      {
        "name": "Accounts",
        "description": "Операции со счетами"
      },
      {
        "name": "Balances",
        "description": "Получение остатков"
      },
      {
        "name": "Statements Async",
        "description": "Асинхронные выписки"
      },
      {
        "name": "Statements Sync",
        "description": "Синхронные выписки"
      }
    ]
  },
  "resources": [
    {
      "tag": "Accounts",
      "summary": "Методы получения информации о счетах",
      "endpoints": [
        {
          "operationId": "getAccounts",
          "method": "GET",
          "path": "/accounts",
          "summary": "Получение списка счетов",
          "description": "Возвращает список счетов и их идентификаторы (accountId), авторизованные пользователем.",
          "parameters": [
            {
              "name": "x-fapi-interaction-id",
              "in": "header",
              "required": true,
              "schema": {
                "type": "string"
              },
              "description": "RFC4122 UUID идентификатор корреляции"
            },
            {
              "name": "page",
              "in": "query",
              "required": false,
              "schema": {
                "type": "integer"
              },
              "description": "Номер страницы"
            }
          ],
          "requestBody": null,
          "responses": [
            {
              "status": "200",
              "description": "OK",
              "content": [
                {
                  "mediaType": "application/json",
                  "schemaRef": "#/components/schemas/AccountResponseLE"
                }
              ]
            }
          ],
          "security": [
            "oauth2"
          ],
          "examples": null
        },
        {
          "operationId": "getAccountsAccountId",
          "method": "GET",
          "path": "/accounts/{accountId}",
          "summary": "Детали счета по accountId",
          "description": "Возвращает детальную информацию по счёту.",
          "parameters": [
            {
              "name": "accountId",
              "in": "path",
              "required": true,
              "schema": {
                "type": "string"
              },
              "description": "Идентификатор счёта"
            },
            {
              "name": "x-fapi-interaction-id",
              "in": "header",
              "required": true,
              "schema": {
                "type": "string"
              },
              "description": "RFC4122 UUID идентификатор корреляции"
            }
          ],
          "requestBody": null,
          "responses": [
            {
              "status": "200",
              "description": "OK",
              "content": [
                {
                  "mediaType": "application/json",
                  "schemaRef": "#/components/schemas/AccountResponseLE"
                }
              ]
            }
          ],
          "security": [
            "oauth2"
          ],
          "examples": null
        }
      ]
    },
