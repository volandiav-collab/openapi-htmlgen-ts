{
  "name": "openapi-htmlgen-ts",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p .",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "lint": "echo \"add eslint if needed\"",
    "bundle:pkg": "esbuild src/cli.ts --bundle --platform=node --target=node18 --format=cjs --outfile=dist-pkg/cli.js",
    "build:binary": "npm run bundle:pkg && pkg pkg-entry.cjs --targets node18-macos-x64,node18-linux-x64,node18-win-x64 --out-path dist/bin"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "js-yaml": "^4.1.0",
    "marked": "^16.4.0",
    "nunjucks": "^3.2.4"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.7.4",
    "@types/nunjucks": "^3.2.6",
    "esbuild": "^0.23.0",
    "pkg": "^5.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "pkg": {
    "assets": [
      "assets/**/*",
      "templates/**/*",
      "schema/**/*.json"
    ],
    "scripts": [
      "dist/**/*.js",
      "dist-pkg/**/*.js"
    ]
  }
}
